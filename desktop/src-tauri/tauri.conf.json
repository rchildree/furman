{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Syllabusser",
  "version": "0.1.0",
  "identifier": "edu.rchildree.syllabusser",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Syllabusser",
        "width": 1440,
        "height": 940,
        "minWidth": 1020,
        "minHeight": 660,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self' preview: http://preview.localhost; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "Education",
    "shortDescription": "Edit course schedules and publish course sites"
  }
}
