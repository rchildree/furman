{
  "name": "syllabusser-schedule-editor",
  "displayName": "Syllabusser Schedule Editor",
  "description": "Edit course schedules, date locks, holidays and attachments inside VS Code.",
  "version": "0.1.4",
  "publisher": "syllabusser",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "syllabusser.open",
        "title": "Syllabusser: Open Schedule"
      },
      {
        "command": "syllabusser.save",
        "title": "Syllabusser: Save Schedule and Holidays"
      }
    ],
    "keybindings": [
      {
        "command": "syllabusser.save",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == syllabusser.schedule"
      }
    ],
    "customEditors": [
      {
        "viewType": "syllabusser.schedule",
        "displayName": "Schedule Editor",
        "selector": [
          {
            "filenamePattern": "**/schedule.yaml"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "syllabusser.open",
          "when": "resourceFilename == schedule.yaml",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.js",
    "test": "node --test test/*.test.js",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vscode/vsce": "^4.1.0"
  }
}
